APP_ENV=local
APP_DEBUG=true
APP_NAME="QS Manager V2"

DB_HOST=db
DB_PORT=5432
DB_NAME=qs_manager_v2
DB_USER=qs_user
DB_PASSWORD=qs_password

EXTERNAL_SERVICES_ENABLED=false
LLM_ENABLED=false
QDRANT_ENABLED=false
WHATSAPP_ENABLED=false

# Escritura server-to-server del catalogo. Mantener desactivada hasta desplegar
# tools/qs-manager-v2-webapp.gs y configurar el mismo secreto en Script Properties.
SHEETS_WRITE_SYNC_ENABLED=false
GAS_CATALOG_WEBAPP_URL=
GAS_CATALOG_SECRET=
